# =========================================================================
# CraftPulse — Environment Variables
# Copy this file to .env.local for development, or set them in Vercel.
# =========================================================================

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CraftPulse"
NODE_ENV="development"

# ----- Database (Neon PostgreSQL) -----
# Pooled connection for serverless runtime
DATABASE_URL="postgresql://user:password@ep-host-pooler.region.aws.neon.tech/craftpulse?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection for migrations
DIRECT_URL="postgresql://user:password@ep-host.region.aws.neon.tech/craftpulse?sslmode=require"

# ----- Auth.js (NextAuth v5) -----
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-secure-random-string"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# ----- Discord OAuth -----
# https://discord.com/developers/applications -> New Application -> OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ----- Google OAuth -----
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ----- Upstash Redis -----
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- Cron Security -----
# Set this in Vercel project settings; used to authorize cron endpoints
CRON_SECRET="replace-with-long-random-string"

# ----- Discord Webhooks (optional, for admin / system notifications) -----
DISCORD_WEBHOOK_URL=""

# ----- Admin bootstrap -----
# Comma-separated list of emails that are auto-promoted to OWNER on first login
ADMIN_BOOTSTRAP_EMAILS=""
