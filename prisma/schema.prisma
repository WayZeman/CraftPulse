// CraftPulse — Prisma schema
// Neon PostgreSQL with connection pooling

generator client {
  provider = "prisma-client-js"
}

// Production target: Neon PostgreSQL. For local zero-setup dev you can
// override the provider to "sqlite" by editing this file locally — do not
// commit that change. When you later wire `prisma migrate deploy` into the
// build, also add `directUrl = env("DIRECT_URL")` and configure DIRECT_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Auth.js models
// =========================================================================

enum Role {
  USER
  VERIFIED
  MODERATOR
  ADMIN
  OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?
  banner        String?
  role          Role      @default(USER)

  // Social
  discordId  String? @unique
  discordTag String?
  website    String?
  twitter    String?
  youtube    String?

  // Metadata
  isBanned   Boolean   @default(false)
  banReason  String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  servers       Server[]
  votes         Vote[]
  reviews       Review[]
  badges        UserBadge[]
  reports       Report[]       @relation("ReportedBy")
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================================================
// Server domain
// =========================================================================

enum ServerStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  BANNED
}

enum ServerEdition {
  JAVA
  BEDROCK
  CROSS_PLATFORM
}

model Server {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  shortDesc   String?
  host        String
  port        Int           @default(25565)
  edition     ServerEdition @default(JAVA)

  // Branding
  logo    String?
  banner  String?
  favicon String? // base64 from MOTD
  motd    String?
  website String?
  discord String?
  trailer String?

  // Owner / status
  ownerId String
  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status  ServerStatus @default(PENDING)
  rejectionReason String?

  // Stats (denormalized for fast queries)
  voteCount      Int      @default(0)
  reviewCount    Int      @default(0)
  averageRating  Float    @default(0)
  totalUptime    Float    @default(0)
  onlinePlayers  Int      @default(0)
  maxPlayers     Int      @default(0)
  peakPlayers    Int      @default(0)
  version        String?
  protocolVer    Int?
  isOnline       Boolean  @default(false)
  lastPing       DateTime?

  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?

  // Meta
  country   String   @default("UA")
  language  String   @default("uk")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  votes        Vote[]
  reviews      Review[]
  tags         ServerTag[]
  uptimeLogs   UptimeLog[]
  pingHistory  PingSnapshot[]
  screenshots  Screenshot[]
  reports      Report[]
  analytics    ServerAnalytics[]
  featuredSlot FeaturedSlot?

  @@index([status, voteCount(sort: Desc)])
  @@index([status, onlinePlayers(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([ownerId])
  @@index([isFeatured])
  @@index([isOnline])
  @@unique([host, port])
}

model Screenshot {
  id        String   @id @default(cuid())
  serverId  String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

// =========================================================================
// Tags
// =========================================================================

model Tag {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String      @unique
  description String?
  color       String      @default("#22c55e")
  icon        String?
  category    TagCategory @default(GAMEPLAY)
  createdAt   DateTime    @default(now())

  servers ServerTag[]

  @@index([category])
}

enum TagCategory {
  GAMEPLAY
  VERSION
  MODE
  ECONOMY
  COMMUNITY
}

model ServerTag {
  serverId String
  tagId    String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serverId, tagId])
  @@index([tagId])
}

// =========================================================================
// Votes + Reviews
// =========================================================================

model Vote {
  id        String   @id @default(cuid())
  userId    String
  serverId  String
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId, createdAt])
  @@index([serverId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([ipHash])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  serverId  String
  rating    Int
  title     String?
  content   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId, createdAt(sort: Desc)])
}

// =========================================================================
// Monitoring data
// =========================================================================

model UptimeLog {
  id        String   @id @default(cuid())
  serverId  String
  isOnline  Boolean
  latency   Int? // ms
  players   Int      @default(0)
  maxPlayers Int     @default(0)
  version   String?
  error     String?
  checkedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, checkedAt(sort: Desc)])
  @@index([checkedAt])
}

// Aggregated hourly snapshots for charting (keeps DB small)
model PingSnapshot {
  id            String   @id @default(cuid())
  serverId      String
  bucket        DateTime
  avgPlayers    Float    @default(0)
  peakPlayers   Int      @default(0)
  uptimePercent Float    @default(0)
  avgLatency    Int      @default(0)
  samples       Int      @default(0)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, bucket])
  @@index([serverId, bucket(sort: Desc)])
}

// =========================================================================
// Analytics
// =========================================================================

model ServerAnalytics {
  id        String   @id @default(cuid())
  serverId  String
  date      DateTime
  views     Int      @default(0)
  uniqueVisitors Int @default(0)
  ipCopies  Int      @default(0)
  votes     Int      @default(0)
  reviewsAdded Int   @default(0)
  clickThroughs Int  @default(0)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, date])
  @@index([date])
}

model PlatformStat {
  id           String   @id @default(cuid())
  date         DateTime @unique
  totalUsers   Int      @default(0)
  totalServers Int      @default(0)
  totalVotes   Int      @default(0)
  totalOnline  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([date(sort: Desc)])
}

// =========================================================================
// Reports / moderation
// =========================================================================

enum ReportReason {
  SPAM
  INAPPROPRIATE
  HATE_SPEECH
  IMPERSONATION
  COPYRIGHT
  OFFLINE_FAKE
  CHEATING
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  serverId   String?
  reportedBy String
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  server   Server? @relation(fields: [serverId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportedBy", fields: [reportedBy], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([serverId])
}

// =========================================================================
// Badges
// =========================================================================

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  color       String   @default("#22c55e")
  rarity      Int      @default(1) // 1-5
  createdAt   DateTime @default(now())

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// =========================================================================
// Editorial featured slots (homepage carousel)
// =========================================================================

model FeaturedSlot {
  id        String   @id @default(cuid())
  serverId  String   @unique
  position  Int
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([position])
}

// =========================================================================
// Notifications
// =========================================================================

enum NotificationType {
  SERVER_APPROVED
  SERVER_REJECTED
  NEW_REVIEW
  NEW_VOTE_MILESTONE
  REPORT_RESOLVED
  BADGE_AWARDED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
}

// =========================================================================
// Activity log (audit trail)
// =========================================================================

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  metadata  String? // JSON-encoded
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
}
